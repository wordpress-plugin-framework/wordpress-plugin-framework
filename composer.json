{
	"name": "hoo-lt/wordpress-plugin-framework",
	"description": "A framework for building WordPress plugins.",
	"type": "library",
	"license": "GPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"WordPressPluginFramework\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WordPressPluginFramework\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"authors": [
		{
			"name": "Baltic digital agency, UAB",
			"email": "hoo@hoo.lt"
		},
		{
			"name": "Viacheslav Ravdin",
			"email": "viacheslav@hoo.lt"
		}
	],
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"phpunit/phpunit": "11.5.*",
		"infection/infection": "*"
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		},
		"platform": {
			"php": "8.4"
		}
	}
}
